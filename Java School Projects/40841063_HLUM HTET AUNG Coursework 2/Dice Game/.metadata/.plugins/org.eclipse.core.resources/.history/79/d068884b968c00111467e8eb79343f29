package part2DiceGame;

import java.util.Random;

public class DiceRolling {
	public static int diceprogram() { // called from BettingProgram for rolling dice
		int die1result;
		int die2result;
		
		Random random = new Random();
		die1result = random.nextInt(6) + 1;
	    die2result = random.nextInt(6) + 1;
	    
	    return die1result + die2result;
	}
}
