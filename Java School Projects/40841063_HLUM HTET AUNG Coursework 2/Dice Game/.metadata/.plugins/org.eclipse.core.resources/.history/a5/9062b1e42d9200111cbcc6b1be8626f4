package part2DiceGame;

public class CurrencyChanger {
	public static double convert(double amount, String currency) {

        switch (currency) {
            case "USD":
                return amount * 1.35;

            case "EUR":
                return amount * 1.16;

            case "MMK":
                return amount * 2800;

            case "GBP":
                return amount;

            default:
                return amount;
        }
    }

    public static String getSymbol(String currency) {
        switch (currency) {
            case "USD": return "$";
            case "EUR": return "€";
            case "MMK": return "K";
            case "GBP": return "£";
            default: return "£";
        }
    }
}
