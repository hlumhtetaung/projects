package part1;

import javax.swing.JOptionPane;

public class Print {

	// 5. Method to print matrix
	public static void print(int[][] matrix) {  // called from MatrixGenerator and Transform
		String output = "";
		
		for (int i = 0; i < matrix.length; i++) {
            for (int j = 0; j < matrix[i].length; j++) {
                output += String.format("%4d", matrix[i][j]) + " ";
            }
            output += "\n";
        }

        JOptionPane.showMessageDialog(null, output);
	}

}
