package part1;

import java.util.Arrays;

import javax.swing.JOptionPane;

public class SecondLargest {

	// 3. Finding row and column with second largest average
	public static void secondLargestAvg(double[] rowsAvg, double[] colsAvg) {
		String outputForSecondLargest = "";
		// Second largest row average
		double[] rowsAvgCopy = rowsAvg.clone();
		Arrays.sort(rowsAvgCopy);
		int startPointer = rowsAvgCopy.length - 1;
		double maxAvg = rowsAvgCopy[startPointer];
		double secondMaxRowAvg = -1.0; 
        for (int i = startPointer - 1; i >= 0; i--) {
            if (rowsAvgCopy[i] < maxAvg) {
                secondMaxRowAvg = rowsAvgCopy[i];
                break;
            }
        }
		// Finding index in original array
        int secondMaxRowIdx = -1;
        for (int i = 0; i < rowsAvg.length; i++) {
            if (rowsAvg[i] == secondMaxRowAvg) {
                secondMaxRowIdx = i;
                break;
            }
        }
        
		// Second largest column average
		double[] colsAvgCopy = colsAvg.clone();
		Arrays.sort(colsAvgCopy);
        int colStartPointer = colsAvgCopy.length - 1;
        double maxColAvg = colsAvgCopy[colStartPointer];

        double secondMaxColAvg = -1.0;
        for (int i = colStartPointer - 1; i >= 0; i--) {
            if (colsAvgCopy[i] < maxColAvg) {
                secondMaxColAvg = colsAvgCopy[i];
                break;
            }
        }

        int secondMaxColIdx = -1;
        for (int i = 0; i < colsAvg.length; i++) {
            if (colsAvg[i] == secondMaxColAvg) {
                secondMaxColIdx = i;
                break;
            }
        }
		
		// Test print
		System.out.println();
		System.out.println("The row with the second largest average (" + String.format("%.2f", secondMaxRowAvg) + ") is the row no " + (secondMaxRowIdx + 1) + " (N=" + (secondMaxRowIdx + 1) + ")");
		System.out.println("and the column with the second largest average (" + String.format("%.2f", secondMaxColAvg) + ") is the col no " + (secondMaxColIdx + 1) + " (M=" + (secondMaxColIdx + 1) + ").");
		outputForSecondLargest += "The row with the second largest average (" + String.format("%.2f", secondMaxRowAvg) + ") is the row no " + (secondMaxRowIdx + 1) + " (N=" + (secondMaxRowIdx + 1) + ")"
		        + "\nand the column with the second largest average (" + String.format("%.2f", secondMaxColAvg) + ") is the col no " + (secondMaxColIdx + 1) + " (M=" + (secondMaxColIdx + 1) + ").";
		JOptionPane.showMessageDialog(null, outputForSecondLargest);
	}

}
