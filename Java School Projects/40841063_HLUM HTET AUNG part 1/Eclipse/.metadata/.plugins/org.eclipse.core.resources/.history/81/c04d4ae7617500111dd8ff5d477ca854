package part1;

import java.util.Arrays;
import java.util.Random;

import javax.swing.JOptionPane;

public class MatrixAssessmentPart1 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		matrixGeneration();
	}
	
	public static void matrixGeneration() {
		Random rand = new Random();
		int rows, cols;
		
		// User input for rows
		do {
			rows = Integer.parseInt(JOptionPane.showInputDialog("Enter the number of rows (3-10)"));
		} while (rows < 3 || rows > 10);
		
		// User input for columns
		do {
			cols = Integer.parseInt(JOptionPane.showInputDialog("Enter the number of columns (3-10)"));
		} while (cols < 3 || cols > 10);
		
		// Matrix generation process
		int[][] matrix = new int[rows][cols];
		
		for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
            	// Even-Odd rows generator
            	if ((i + 1) % 2 == 0) {
            		matrix[i][j] = rand.nextInt(501) * 2;
            	} else {
            		matrix[i][j] = rand.nextInt(500) * 2 + 1;
            	}
            }
        }
		print(matrix);
		averageTable(matrix);
	}
	
	public static void averageTable(int[][] matrix) {
		// calculating number of rows and columns
		int numRows = matrix.length;
		int numCols = matrix[0].length;
		
		double[] rowsAvg = new double[numRows];
		double[] colsAvg = new double[numCols];
		
		int sum;
		int totalSum = 0;
		double wholeAvg;
		String outputForSecondLargest = "";
		
		// System.out.println("The matrix has " + numRows + " rows and " + numCols + " columns.");
		
		// Note: Delete this console test print
		for (int i = 0; i < numRows; i++) {
			for (int j = 0; j < numCols; j++) {
				System.out.print(matrix[i][j] + " ");
			}
			System.out.println();
		}
		System.out.println();
		
		// Row average calculation
		System.out.println("The average for each row: ");
		for (int i = 0; i < numRows; i++) {
			sum = 0;
			for (int j = 0; j < numCols; j++) {
				sum += matrix[i][j];
			}
			rowsAvg[i] = (double)sum / numCols;
			System.out.println(String.format("%.2f", (double) sum / numCols)); // testing row average results
		}
		System.out.println();
		
		// Column average calculation
		System.out.println("The average for each column: ");
		for (int j = 0; j < numCols; j++) {
		    sum = 0;

		    for (int i = 0; i < numRows; i++) {
		        sum += matrix[i][j];
		    }

		    colsAvg[j] = (double) sum / numRows;
		    System.out.print(String.format("%.2f", (double) sum / numRows) + " "); // testing column average results
		}
		System.out.println();
		System.out.println();
		
		// Whole matrix average
		for (int i = 0; i < numRows; i++) {
			for (int j = 0; j < numCols; j++) {
				totalSum += matrix[i][j];
			}
		}
		wholeAvg = (double) totalSum / (numRows * numCols);
		System.out.println("The average for whole matrix: " + String.format("%.2f", wholeAvg));
		
		// Finding row and column with second largest average
		// Second largest row average
		double[] rowsAvgCopy = rowsAvg.clone();
		Arrays.sort(rowsAvgCopy);
		int startPointer = rowsAvgCopy.length - 1;
		double maxAvg = rowsAvgCopy[startPointer];
		double secondMaxRowAvg = -1.0; 
        for (int i = startPointer - 1; i >= 0; i--) {
            if (rowsAvgCopy[i] < maxAvg) {
                secondMaxRowAvg = rowsAvgCopy[i];
                break;
            }
        }
		// Finding index in original array
        int secondMaxRowIdx = -1;
        for (int i = 0; i < rowsAvg.length; i++) {
            if (rowsAvg[i] == secondMaxRowAvg) {
                secondMaxRowIdx = i;
                break;
            }
        }
        
		// Second largest column average
		double[] colsAvgCopy = colsAvg.clone();
		Arrays.sort(colsAvgCopy);
        int colStartPointer = colsAvgCopy.length - 1;
        double maxColAvg = colsAvgCopy[colStartPointer];

        double secondMaxColAvg = -1.0;
        for (int i = colStartPointer - 1; i >= 0; i--) {
            if (colsAvgCopy[i] < maxColAvg) {
                secondMaxColAvg = colsAvgCopy[i];
                break;
            }
        }

        int secondMaxColIdx = -1;
        for (int i = 0; i < colsAvg.length; i++) {
            if (colsAvg[i] == secondMaxColAvg) {
                secondMaxColIdx = i;
                break;
            }
        }
		
		// Test print
		System.out.println();
		System.out.println("The row with the second largest average (" + String.format("%.2f", secondMaxRowAvg) + ") is the row no " + (secondMaxRowIdx + 1) + " (N=" + (secondMaxRowIdx + 1) + ")");
		System.out.println("and the column with the second largest average (" + String.format("%.2f", secondMaxColAvg) + ") is the col no " + (secondMaxColIdx + 1) + " (M=" + (secondMaxColIdx + 1) + ").");
		outputForSecondLargest += "The row with the second largest average (" + String.format("%.2f", secondMaxRowAvg) + ") is the row no " + (secondMaxRowIdx + 1) + " (N=" + (secondMaxRowIdx + 1) + ")"
		        + "\nand the column with the second largest average (" + String.format("%.2f", secondMaxColAvg) + ") is the col no " + (secondMaxColIdx + 1) + " (M=" + (secondMaxColIdx + 1) + ").";
		JOptionPane.showMessageDialog(null, outputForSecondLargest);
		
		// Transforming matrix -1, 0, 1
		int[][] modifiedMatrix = new int[numRows][numCols];
		
		// Counters for Step 5
		int countPlusOne = 0;
		int countMinusOne = 0;
		int countZero = 0;
		String outputForTransformation = "";
		
		for (int i = 0; i < numRows; i++) {
			for (int j = 0; j < numCols; j++) {
				// Larger than both row and column averages
				if (matrix[i][j] > rowsAvg[i] && matrix[i][j] > colsAvg[j]) {
					modifiedMatrix[i][j] = 1;
					countPlusOne++;
				} 
				// Smaller than both row and column averages
				else if (matrix[i][j] < rowsAvg[i] && matrix[i][j] < colsAvg[j]) {
					modifiedMatrix[i][j] = -1;
					countMinusOne++;
				} 
				// Condition for 0
				else {
					modifiedMatrix[i][j] = 0;
					countZero++;
				}
			}
		}
		
		
		print(modifiedMatrix);
		// output for transformation count
		System.out.println("\n--- Cell Value Counts ---");
		System.out.println("Cells with value +1: " + countPlusOne);
		System.out.println("Cells with value -1: " + countMinusOne);
		System.out.println("Cells with value  0: " + countZero);
		outputForTransformation = "\n--- Cell Value Counts ---\n" +
                "Cells with value +1: " + countPlusOne + "\n" +
                "Cells with value -1: " + countMinusOne + "\n" +
                "Cells with value  0: " + countZero + "\n";
		JOptionPane.showMessageDialog(null, outputForTransformation);
		
	}
	
	// Method to print matrix
	public static void print(int[][] matrix) {
		String output = "";
		
		for (int i = 0; i < matrix.length; i++) {
            for (int j = 0; j < matrix[i].length; j++) {
                output += String.format("%4d", matrix[i][j]) + " ";
            }
            output += "\n";
        }

        JOptionPane.showMessageDialog(null, output);
	}

}
